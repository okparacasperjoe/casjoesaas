            </ul>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <h1>Create Short Link</h1>
                <p>Paste a long URL to generate a short, trackable Casjoe link.</p>
            </div>

            <?php if (isset($_GET['error'])): ?>
                <div style="background: #fee2e2; color: #ef4444; padding: 12px; border-radius: 8px; margin-top: 20px; max-width: 600px; display:flex; align-items:center; gap: 10px;">
                    <ion-icon name="alert-circle"></ion-icon>
                    <?= htmlspecialchars($_GET['error']) ?>
                </div>
            <?php endif; ?>

            <div class="creation-card">
                <form action="/links/short/store" method="POST">
                    <input type="hidden" name="csrf_token" value="<?= \App\Core\Services\CsrfService::generateToken() ?>">
                    
                    <div class="form-group" style="margin-bottom: 25px;">
                        <label class="form-label">Destination URL</label>
                        <input type="url" name="long_url" class="form-control" required placeholder="https://very-long-website.com/article/123" autofocus>
                    </div>

                    <div class="form-group" style="margin-bottom: 25px;">
                        <label class="form-label">Short Alias (Optional)</label>
                        <div class="input-group">
                            <div class="input-group-text">casjoe.com/</div>
                            <input type="text" name="short_code" placeholder="my-custom-link">
                        </div>
                        <small style="color: #94a3b8; font-size: 13px; margin-top: 5px; display: block;">Leave empty to generate a random string.</small>
                    </div>

                    <div class="form-group" style="margin-bottom: 30px;">
                        <label class="form-label">Expiration (Optional)</label>
                        <input type="datetime-local" name="expires_at" class="form-control" style="color: #64748b;">
                    </div>

                    <button type="submit" class="btn-brand">
                        <ion-icon name="flash"></ion-icon>
                        Shorten It
                    </button>
                    
                    <a href="/links/short" class="btn-cancel">Cancel</a>
                </form>
            </div>
        </main>
    </div>
</body>
