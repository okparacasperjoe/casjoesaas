{
	"appId": "com.casjoe.app",
	"appName": "Casjoe",
	"webDir": "www",
	"bundledWebRuntime": false,
	"server": {
		"url": "https://app.casjoe.com/dashboard",
		"cleartext": false,
		"allowNavigation": [
			"app.casjoe.com",
			"casjoe.com",
			"*.casjoe.com",
			"checkout.paystack.com",
			"api.ravepay.co",
			"accounts.google.com"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"launchAutoHide": true,
			"backgroundColor": "#FFFFFF",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#FFFFFF"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
